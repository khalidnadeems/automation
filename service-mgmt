import streamlit as st
import pandas as pd
import subprocess
import json

# Function to run PowerShell command on a remote server
def run_powershell_command(server, command):
    try:
        # PowerShell command for remote execution
        cmd = f'powershell Invoke-Command -ComputerName {server} -ScriptBlock {{{command}}} | ConvertTo-Json -Compress'
        output = subprocess.run(cmd, capture_output=True, text=True, shell=True)

        if output.stdout:
            return json.loads(output.stdout)
        else:
            return {"Error": f"Failed to fetch from {server}"}
    except Exception as e:
        return {"Error": str(e)}

# Function to fetch Windows services from a remote server
def get_windows_services(server):
    command = "Get-Service | Select-Object Name,Status"
    services = run_powershell_command(server, command)
    
    if isinstance(services, list):
        return {svc["Name"]: svc["Status"] for svc in services}
    return services

# Function to fetch IIS websites from a remote server
def get_iis_websites(server):
    command = "Get-Website | Select-Object Name,State"
    websites = run_powershell_command(server, command)

    if isinstance(websites, list):
        return {site["Name"]: site["State"] for site in websites}
    return websites

# Function to fetch Task Scheduler tasks from a remote server
def get_scheduled_tasks(server):
    command = "Get-ScheduledTask | Select-Object TaskName,State"
    tasks = run_powershell_command(server, command)

    if isinstance(tasks, list):
        return {task["TaskName"]: task["State"] for task in tasks}
    return tasks

# Define environments and their respective servers
env_servers = {
    "Dev": ["RemoteServer1", "RemoteServer2"],
    "Prod": ["RemoteServer3"]
}

# Sidebar Navigation
st.sidebar.title("Navigation")
page = st.sidebar.radio("Select a page", ["Service Management", "Release Management"])

# Service Management Page (Default)
if page == "Service Management":
    st.title("Service Management")

    # Environment Selection Dropdown
    selected_env = st.selectbox("Select Environment", options=list(env_servers.keys()))

    if selected_env:
        data = []

        for server in env_servers[selected_env]:
            windows_services = get_windows_services(server)
            iis_services = get_iis_websites(server)
            task_scheduler = get_scheduled_tasks(server)

            row = {
                "Server Name": server,
                "Windows Services": "\n".join([f"{svc} ({status})" for svc, status in windows_services.items()]),
                "IIS Services": "\n".join([f"{site} ({state})" for site, state in iis_services.items()]),
                "Task Scheduler": "\n".join([f"{task} ({state})" for task, state in task_scheduler.items()]),
            }
            data.append(row)

        df = pd.DataFrame(data)
        st.dataframe(df)

# Release Management Page
elif page == "Release Management":
    st.title("Release Management")
    st.write("This page is under development.")
